// ============================================================
//  SafyEdu — Production Prisma Schema
//  Version : 1.0.0  (Phase 1 — Multi-Tenant Core + RBAC)
//
//  Architectural decisions
//  ──────────────────────────────────────────────────────────
//  • Every school is a `Tenant`.  All domain models carry a
//    tenantId FK so that a single PostgreSQL instance (with
//    Row-Level Security enabled at the DB layer) can service
//    hundreds of schools without data bleed.
//
//  • A `Department` represents an educational track inside a
//    school (National, IGCSE, American, IB).  Each department
//    owns its own grading scale stored as JSONB, term calendar,
//    and report template reference.  This is the "Dynamic
//    Curriculum Engine" core.
//
//  • `User` is a unified identity across all roles (Admin,
//    Teacher, Parent, Student, BusMatron, CanteenOperator,
//    Superadmin).  Role assignment is done via `UserRole` which
//    binds a User to a Role scoped to a specific Tenant and
//    optionally to a Department — enabling cross-department
//    staff (e.g., a teacher who covers both National and IGCSE).
//
//  • Parent <-> Student is a many-to-many relationship via
//    `ParentStudentLink`.  A single parent account can be linked
//    to siblings across different departments (different tracks)
//    within the same Tenant.
//
//  • Financial double-entry ledger, canteen wallet, PTM
//    bookings, substitution engine, and school store are
//    modelled here to give Prisma full relational integrity
//    from day one.  Feature-specific service layers will build
//    on top of these models in subsequent phases.
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, uuid_ossp(map: "uuid-ossp")]
}

// ──────────────────────────────────────────────────────────
//  ENUMERATIONS
// ──────────────────────────────────────────────────────────

/// Top-level system roles. Fine-grained permissions are
/// managed by the `Permission` model and `RolePermission` join.
enum SystemRole {
  SUPERADMIN        // Platform-level; access to ALL tenants
  SCHOOL_ADMIN      // Full access within their tenant
  VICE_PRINCIPAL
  HEAD_OF_DEPARTMENT
  TEACHER
  STUDENT
  PARENT
  BUS_MATRON        // Field-mode: boarding only
  CANTEEN_OPERATOR  // Field-mode: POS terminal only
  LIBRARIAN
  ACCOUNTANT
  RECEPTIONIST
}

/// Educational tracks offered by a school.
/// A single Tenant can have multiple DepartmentType values.
enum DepartmentType {
  NATIONAL    // Egyptian National Curriculum (MoE)
  IGCSE       // British IGCSE / A-Level
  AMERICAN    // American Diploma (AP, SAT)
  IB          // International Baccalaureate
  AZHARI      // Al-Azhar national track
}

/// Academic term types — terminology varies by curriculum.
enum TermType {
  SEMESTER_1   // National / American
  SEMESTER_2
  TRIMESTER_1  // IB
  TRIMESTER_2
  TRIMESTER_3
  QUARTER_1    // Some American schools
  QUARTER_2
  QUARTER_3
  QUARTER_4
}

enum Gender {
  MALE
  FEMALE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// Canonical transaction types for the double-entry ledger.
enum TransactionType {
  TUITION_FEE        // School charges tuition
  CANTEEN_DEBIT      // Student spends at canteen
  CANTEEN_CREDIT     // Parent tops up canteen wallet
  BUS_FEE
  UNIFORM_PURCHASE
  BOOK_PURCHASE
  ACTIVITY_FEE
  PENALTY
  REFUND
  ADJUSTMENT
  TOP_UP             // Generic wallet top-up
}

enum PaymentMethod {
  CASH
  CARD
  FAWRY
  PAYMOB_CARD
  PAYMOB_WALLET     // Mobile wallet (Vodafone Cash, etc.)
  INSTAPAY
  BANK_TRANSFER
  NFC_WALLET        // On-campus NFC card
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BusRouteStatus {
  IDLE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BoardingStatus {
  BOARDED
  ALIGHTED
  ABSENT
  PARENT_PICKUP // Parent opted out for the day
}

enum PTMMode {
  PHYSICAL
  ONLINE   // Video call link attached
}

enum PTMStatus {
  AVAILABLE
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum StoreOrderStatus {
  PENDING_PAYMENT
  PAID
  READY_FOR_PICKUP
  PICKED_UP
  CANCELLED
}

enum SubstitutionStatus {
  PENDING
  ACCEPTED
  DECLINED
  AUTO_ASSIGNED
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE // Full CRUD + config
}

// ──────────────────────────────────────────────────────────
//  TENANT (School)
// ──────────────────────────────────────────────────────────

/// Root multi-tenant entity.  Every other model references
/// this via `tenantId`.  Deleting a Tenant cascades to nothing
/// at the DB level — hard deletes are prevented by a soft-delete
/// `archivedAt` pattern to preserve financial audit trails.
model Tenant {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Official school name in Arabic (primary)
  nameAr          String
  /// Official school name in English
  nameEn          String
  slug            String    @unique // URL-safe identifier e.g. "cairo-british-school"
  logoUrl         String?
  coverImageUrl   String?
  primaryColor    String    @default("#1A56DB") // Brand color hex
  accentColor     String    @default("#E3A008")
  /// Egyptian Ministry of Education school registration code
  moeCode         String?   @unique
  countryCode     String    @default("EG")
  governorate     String?   // Cairo, Giza, Alexandria, etc.
  address         String?
  phone           String?
  email           String?   @unique
  website         String?
  isActive        Boolean   @default(true)
  /// Max number of students allowed under current license tier
  studentCapacity Int       @default(500)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  departments      Department[]
  academicYears    AcademicYear[]
  users            User[]
  userRoles        UserRole[]
  classrooms       Classroom[]
  subjects         Subject[]
  busRoutes        BusRoute[]
  storeItems       StoreItem[]
  announcements    Announcement[]
  ticketQueues     TicketQueue[]
  subscriptionTier TenantSubscription?

  @@index([slug])
  @@index([moeCode])
  @@map("tenants")
}

/// SaaS subscription tier attached to a Tenant.
model TenantSubscription {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @unique @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  tier         String   @default("STARTER") // STARTER | PROFESSIONAL | ENTERPRISE
  maxStudents  Int      @default(500)
  maxStaff     Int      @default(50)
  featuresJson Json     @default("{}") // Feature flags per tier
  startsAt     DateTime
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("tenant_subscriptions")
}

// ──────────────────────────────────────────────────────────
//  DEPARTMENT  (Educational Track)
// ──────────────────────────────────────────────────────────

/// A curriculum track within a school.  Grading logic,
/// term calendars, and report templates are scoped here.
model Department {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @db.Uuid
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         DepartmentType
  /// Display label e.g. "القسم الوطني" or "British IGCSE Section"
  nameAr       String
  nameEn       String
  /// JSONB grading scale config — allows each department to define
  /// its own pass marks, grade boundaries, GPA weights, etc.
  /// Example for IGCSE: { "A*": { min: 90 }, "A": { min: 80 }, ... }
  /// Example for National: { "Excellent": { min: 85 }, "VeryGood": { min: 75 }, ... }
  gradingScale Json           @default("{}")
  /// JSONB report card template reference and column config
  reportConfig Json           @default("{}")
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  stages         Stage[]
  terms          AcademicTerm[]
  userRoles      UserRole[]     // Teachers/HODs assigned to this dept
  subjects       Subject[]
  timetableSlots TimetableSlot[]

  @@unique([tenantId, type]) // One track per type per school
  @@index([tenantId])
  @@map("departments")
}

// ──────────────────────────────────────────────────────────
//  ACADEMIC STRUCTURE
// ──────────────────────────────────────────────────────────

/// Academic year entity.  All scheduling and gradebook
/// entries are anchored to an AcademicYear.
model AcademicYear {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label       String    // "2025/2026"
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  terms       AcademicTerm[]
  classrooms  Classroom[]
  enrollments Enrollment[]

  @@unique([tenantId, label])
  @@index([tenantId, isCurrent])
  @@map("academic_years")
}

/// A term / semester within an academic year,
/// scoped per Department because IGCSE uses 3 terms
/// while National uses 2 semesters.
model AcademicTerm {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  departmentId   String       @db.Uuid
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  type           TermType
  label          String       // "Term 1 2025/2026"
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  isActive       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  grades      Grade[]
  assessments Assessment[]
  ptmCycles   PTMCycle[]

  @@unique([academicYearId, departmentId, type])
  @@index([departmentId])
  @@map("academic_terms")
}

/// Broad educational stage (Primary, Preparatory, Secondary).
/// Maps loosely to "المرحلة" in the Egyptian system.
model Stage {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  nameAr       String     // "المرحلة الابتدائية"
  nameEn       String     // "Primary"
  order        Int        // Display/sort order

  gradeLevels GradeLevel[]

  @@unique([departmentId, order])
  @@index([departmentId])
  @@map("stages")
}

/// A specific year within a stage (Grade 1, Year 7, Form 3...).
model GradeLevel {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stageId   String     @db.Uuid
  stage     Stage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  nameAr    String     // "الصف الأول"
  nameEn    String     // "Grade 1"
  order     Int

  classrooms Classroom[]

  @@unique([stageId, order])
  @@index([stageId])
  @@map("grade_levels")
}

/// A physical classroom / section (e.g., "Grade 7 Section A").
model Classroom {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String       @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  gradeLevelId   String       @db.Uuid
  gradeLevel     GradeLevel   @relation(fields: [gradeLevelId], references: [id])
  section        String       // "A", "B", "C"
  roomNumber     String?
  capacity       Int          @default(30)
  /// The homeroom / form teacher
  hometeacherId  String?      @db.Uuid
  hometeacher    User?        @relation("HometeacherClassrooms", fields: [hometeacherId], references: [id])

  enrollments    Enrollment[]
  timetableSlots TimetableSlot[]
  attendances    Attendance[]

  @@unique([gradeLevelId, academicYearId, section])
  @@index([tenantId])
  @@map("classrooms")
}

// ──────────────────────────────────────────────────────────
//  USER, ROLE & RBAC
// ──────────────────────────────────────────────────────────

/// Unified user record across ALL roles.
/// Role-specific profile data (e.g., teacherProfile, studentProfile)
/// is stored in dedicated one-to-one extension tables to keep
/// the core user table lean and queryable.
model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String?    @db.Uuid // NULL for SUPERADMIN
  tenant          Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Unique login email — shared across tenants for SSO in future
  email           String     @unique
  phone           String?    @unique
  passwordHash    String
  firstNameAr     String
  lastNameAr      String
  firstNameEn     String?
  lastNameEn      String?
  nationalId      String?    // Egyptian National ID (14 digits)
  dateOfBirth     DateTime?  @db.Date
  gender          Gender?
  avatarUrl       String?
  status          UserStatus @default(PENDING_VERIFICATION)
  /// Preferred interface language
  preferredLang   String     @default("ar") // "ar" | "en"
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  fcmTokens       String[]   // Firebase push notification tokens (multi-device)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Role assignments (a user can have multiple roles across depts)
  roles UserRole[]

  // Profile extensions (at most one of each per user)
  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?
  parentProfile    ParentProfile?
  busMatronProfile BusMatronProfile?

  // Classroom relations
  hometeacherOf Classroom[] @relation("HometeacherClassrooms")

  // Auth
  refreshTokens RefreshToken[]

  // Academic
  grades             Grade[]      @relation("StudentGrades")
  teacherAssessments Assessment[] @relation("TeacherAssessments")
  attendances        Attendance[] @relation("StudentAttendances")
  takenAttendances   Attendance[] @relation("TakenByUser")

  // Substitution
  absentTeacherSubs     TeacherSubstitution[] @relation("AbsentTeacher")
  substituteTeacherSubs TeacherSubstitution[] @relation("SubstituteTeacher")

  // PTM
  teacherPTMSlots   PTMSlot[]    @relation("TeacherPTMSlots")
  parentPTMBookings PTMBooking[] @relation("ParentPTMBookings")

  // Store
  storeOrders StoreOrder[]

  // Wallet
  wallet Wallet?

  // Tickets
  raisedTickets   Ticket[] @relation("TicketRaiser")
  assignedTickets Ticket[] @relation("TicketAssignee")

  // Messaging
  sentMessages Message[] @relation("MessageSender")

  // NFC boarding
  boardingLogs    BoardingLog[] @relation("BoardingStudent")
  scannedBoarding BoardingLog[] @relation("ScannedByMatron")

  // Announcements
  announcements Announcement[]

  @@index([tenantId])
  @@index([email])
  @@index([nationalId])
  @@map("users")
}

/// JWT refresh token store in PostgreSQL (used as fallback/audit;
/// active sessions are primarily managed in Redis).
model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // Store hash, never plaintext
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

/// A named role definition scoped to a Tenant (or global for SUPERADMIN).
model Role {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?        @db.Uuid // NULL means platform-wide role
  name        String
  systemRole  SystemRole     @unique
  description String?
  isSystem    Boolean        @default(true) // System roles cannot be deleted

  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

/// Fine-grained permission definition.
model Permission {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Resource name e.g. "student", "grade", "bus_route"
  resource String
  action   PermissionAction
  label    String

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

/// Join table: Role <-> Permission
model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Assigns a Role to a User within a Tenant, optionally scoped
/// to a specific Department.  A teacher can be TEACHER in the
/// National dept and HEAD_OF_DEPARTMENT in IGCSE simultaneously.
model UserRole {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String      @db.Uuid
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String      @db.Uuid
  role         Role        @relation(fields: [roleId], references: [id])
  tenantId     String      @db.Uuid
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Optional dept scoping (NULL = role applies to all departments)
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])
  assignedAt   DateTime    @default(now())
  assignedById String?     @db.Uuid

  @@unique([userId, roleId, departmentId])
  @@index([tenantId, userId])
  @@map("user_roles")
}

// ──────────────────────────────────────────────────────────
//  PROFILE EXTENSIONS
// ──────────────────────────────────────────────────────────

/// Student-specific data — kept separate to allow the User
/// table to remain lightweight and RBAC-driven.
model StudentProfile {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @unique @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId         String    @db.Uuid
  /// School-issued student code (printed on ID card and NFC card)
  studentCode      String    @unique
  nfcCardUid       String?   @unique // NFC card physical UID
  bloodType        String?
  medicalNotes     String?

  transportAssignment BusRouteAssignment?
  enrollments         Enrollment[]
  parentLinks         ParentStudentLink[]
  canteenPurchases    CanteenTransaction[]

  @@index([tenantId])
  @@index([studentCode])
  @@index([nfcCardUid])
  @@map("student_profiles")
}

model TeacherProfile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId        String   @db.Uuid
  teacherCode     String   @unique
  /// Subjects this teacher is qualified to teach (array of Subject IDs)
  qualifications  String[] @db.Uuid
  /// Teacher specialisations in free text (e.g., ["Mathematics", "Physics"])
  specialisations String[]
  hireDate        DateTime? @db.Date
  isSubstitutable Boolean  @default(true) // Eligible to receive auto-substitution

  timetableSlots TimetableSlot[]    @relation("PrimaryTeacher")
  availabilities TeacherAvailability[]

  @@index([tenantId])
  @@map("teacher_profiles")
}

model ParentProfile {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @unique @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId   String    @db.Uuid
  occupation String?
  /// WhatsApp number for automated notifications (Egyptian +20...)
  whatsapp   String?

  childLinks ParentStudentLink[]

  @@index([tenantId])
  @@map("parent_profiles")
}

model BusMatronProfile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId      String   @db.Uuid
  badgeNumber   String   @unique

  assignedRoute BusRoute? @relation("MatronRoute")

  @@index([tenantId])
  @@map("bus_matron_profiles")
}

// ──────────────────────────────────────────────────────────
//  PARENT <-> STUDENT LINKAGE
// ──────────────────────────────────────────────────────────

/// Many-to-many parent-to-student with relationship metadata.
/// Supports step-parents, guardians, and split custody.
model ParentStudentLink {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentProfileId  String         @db.Uuid
  parentProfile    ParentProfile  @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  studentProfileId String         @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  /// Relationship type e.g. "Father", "Mother", "Guardian"
  relationship      String
  /// Can this parent view grades / financial statements?
  canViewAcademics  Boolean @default(true)
  canViewFinancials Boolean @default(true)
  canPickup         Boolean @default(true)
  isPrimary         Boolean @default(false) // Primary contact
  createdAt         DateTime @default(now())

  @@unique([parentProfileId, studentProfileId])
  @@index([studentProfileId])
  @@map("parent_student_links")
}

// ──────────────────────────────────────────────────────────
//  ENROLLMENT
// ──────────────────────────────────────────────────────────

/// Ties a student to a specific classroom for an academic year.
model Enrollment {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentProfileId String         @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  classroomId      String         @db.Uuid
  classroom        Classroom      @relation(fields: [classroomId], references: [id])
  academicYearId   String         @db.Uuid
  academicYear     AcademicYear   @relation(fields: [academicYearId], references: [id])
  enrolledAt       DateTime       @default(now())
  withdrawnAt      DateTime?

  @@unique([studentProfileId, academicYearId])
  @@index([classroomId])
  @@map("enrollments")
}

// ──────────────────────────────────────────────────────────
//  SUBJECTS & TIMETABLE
// ──────────────────────────────────────────────────────────

model Subject {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  nameAr       String
  nameEn       String
  code         String     // e.g. "MATH101", "BIO-IGCSE"
  weeklyHours  Int        @default(4)
  isElective   Boolean    @default(false)
  createdAt    DateTime   @default(now())

  timetableSlots TimetableSlot[]
  assessments    Assessment[]
  grades         Grade[]

  @@unique([tenantId, departmentId, code])
  @@index([departmentId])
  @@map("subjects")
}

/// A recurring slot in the weekly timetable.
model TimetableSlot {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId     String         @db.Uuid
  department       Department     @relation(fields: [departmentId], references: [id])
  classroomId      String         @db.Uuid
  classroom        Classroom      @relation(fields: [classroomId], references: [id])
  subjectId        String         @db.Uuid
  subject          Subject        @relation(fields: [subjectId], references: [id])
  teacherProfileId String         @db.Uuid
  teacherProfile   TeacherProfile @relation("PrimaryTeacher", fields: [teacherProfileId], references: [id])
  /// 0 = Sunday (Egyptian week starts Sun), 1 = Monday, ... 4 = Thursday
  dayOfWeek        Int
  periodNumber     Int
  startTime        String         // "08:00"
  endTime          String         // "08:45"
  roomLabel        String?

  substitutions TeacherSubstitution[]

  @@unique([classroomId, dayOfWeek, periodNumber])
  @@index([teacherProfileId, dayOfWeek])
  @@map("timetable_slots")
}

// ──────────────────────────────────────────────────────────
//  ATTENDANCE
// ──────────────────────────────────────────────────────────

model Attendance {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classroomId  String           @db.Uuid
  classroom    Classroom        @relation(fields: [classroomId], references: [id])
  studentId    String           @db.Uuid
  student      User             @relation("StudentAttendances", fields: [studentId], references: [id])
  takenById    String           @db.Uuid
  takenBy      User             @relation("TakenByUser", fields: [takenById], references: [id])
  date         DateTime         @db.Date
  periodNumber Int?
  status       AttendanceStatus
  notes        String?
  createdAt    DateTime         @default(now())

  @@unique([classroomId, studentId, date, periodNumber])
  @@index([studentId, date])
  @@map("attendances")
}

// ──────────────────────────────────────────────────────────
//  GRADES & ASSESSMENTS
// ──────────────────────────────────────────────────────────

/// An assessment event (exam, quiz, coursework).
model Assessment {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termId      String       @db.Uuid
  term        AcademicTerm @relation(fields: [termId], references: [id])
  subjectId   String       @db.Uuid
  subject     Subject      @relation(fields: [subjectId], references: [id])
  createdById String       @db.Uuid
  createdBy   User         @relation("TeacherAssessments", fields: [createdById], references: [id])
  title       String
  titleAr     String?
  totalMarks  Decimal      @db.Decimal(6, 2)
  weight      Decimal      @db.Decimal(5, 2) // % weight in final grade
  date        DateTime?    @db.Date
  createdAt   DateTime     @default(now())

  grades Grade[]

  @@index([termId, subjectId])
  @@map("assessments")
}

model Grade {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId  String       @db.Uuid
  assessment    Assessment   @relation(fields: [assessmentId], references: [id])
  subjectId     String       @db.Uuid
  subject       Subject      @relation(fields: [subjectId], references: [id])
  termId        String       @db.Uuid
  term          AcademicTerm @relation(fields: [termId], references: [id])
  studentId     String       @db.Uuid
  student       User         @relation("StudentGrades", fields: [studentId], references: [id])
  marksObtained Decimal      @db.Decimal(6, 2)
  /// Computed letter grade (A*, A, B+, ...) — stored for fast reporting
  letterGrade   String?
  comments      String?
  enteredAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId, termId])
  @@map("grades")
}

// ──────────────────────────────────────────────────────────
//  FINANCIAL — WALLET & DOUBLE-ENTRY LEDGER
// ──────────────────────────────────────────────────────────

/// Each student gets exactly one Wallet covering both
/// tuition balance and canteen balance tracking.
model Wallet {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @unique @db.Uuid
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId           String    @db.Uuid
  /// Current confirmed balance in Egyptian Pounds (EGP)
  balance            Decimal   @default(0) @db.Decimal(12, 2)
  /// Daily canteen spending cap set by parent (0 = no limit)
  dailyLimit         Decimal   @default(0) @db.Decimal(8, 2)
  /// Prohibited food category IDs (FK to CanteenCategory)
  blockedCategoryIds String[]  @db.Uuid
  /// Prohibited specific item IDs (FK to CanteenItem)
  blockedItemIds     String[]  @default([]) @db.Uuid
  /// Prohibited allergen tags or dietary keywords (e.g. ["Peanuts", "Soda", "Gluten"])
  blockedKeywords    String[]  @default([])
  nfcCardUid         String?   @unique // Linked NFC card/wristband UID
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  transactions WalletTransaction[]

  @@index([tenantId])
  @@map("wallets")
}

/// Double-entry ledger line — every financial movement is
/// recorded here.  Aggregated balances are derived or cached.
model WalletTransaction {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId        String          @db.Uuid
  wallet          Wallet          @relation(fields: [walletId], references: [id])
  type            TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  /// +ve for credits, -ve for debits
  direction       Int             // 1 = CREDIT, -1 = DEBIT
  balanceAfter    Decimal         @db.Decimal(12, 2)
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus   @default(COMPLETED)
  /// External gateway reference (Paymob order ID, Fawry ref, etc.)
  gatewayRef      String?
  gatewayResponse Json?
  description     String?
  canteenTxId     String?         @db.Uuid
  relatedOrderId  String?         @db.Uuid
  createdAt       DateTime        @default(now())

  @@index([walletId, createdAt])
  @@index([gatewayRef])
  @@map("wallet_transactions")
}

// ──────────────────────────────────────────────────────────
//  CANTEEN
// ──────────────────────────────────────────────────────────

model CanteenCategory {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String        @db.Uuid
  nameAr   String
  nameEn   String
  icon     String?

  items CanteenItem[]

  @@index([tenantId])
  @@map("canteen_categories")
}

model CanteenItem {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @db.Uuid
  categoryId  String          @db.Uuid
  category    CanteenCategory @relation(fields: [categoryId], references: [id])
  nameAr      String
  nameEn      String
  price       Decimal         @db.Decimal(8, 2)
  imageUrl    String?
  isAvailable Boolean         @default(true)
  allergens   String[]
  createdAt   DateTime        @default(now())

  lineItems CanteenTransactionLine[]

  @@index([tenantId, isAvailable])
  @@map("canteen_items")
}

/// A single canteen purchase (NFC tap at POS).
model CanteenTransaction {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @db.Uuid
  studentProfileId String    @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  totalAmount      Decimal   @db.Decimal(10, 2)
  paidAt           DateTime  @default(now())
  operatorId       String?   @db.Uuid // Canteen operator user ID

  lineItems CanteenTransactionLine[]

  @@index([studentProfileId, paidAt])
  @@map("canteen_transactions")
}

model CanteenTransactionLine {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String             @db.Uuid
  transaction   CanteenTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  itemId        String             @db.Uuid
  item          CanteenItem        @relation(fields: [itemId], references: [id])
  quantity      Int
  unitPrice     Decimal            @db.Decimal(8, 2)
  lineTotal     Decimal            @db.Decimal(10, 2)

  @@map("canteen_transaction_lines")
}

// ──────────────────────────────────────────────────────────
//  LOGISTICS — BUS ROUTES & BOARDING
// ──────────────────────────────────────────────────────────

model BusRoute {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @db.Uuid
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  vehiclePlate String
  capacity     Int            @default(40)
  matronId     String?        @unique @db.Uuid
  matron       BusMatronProfile? @relation("MatronRoute", fields: [matronId], references: [id])
  /// Driver name (driver does not have a system user account by default)
  driverName   String?
  driverPhone  String?
  status       BusRouteStatus @default(IDLE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  stops        BusStop[]
  assignments  BusRouteAssignment[]
  boardingLogs BoardingLog[]

  @@index([tenantId])
  @@map("bus_routes")
}

/// A fixed stop on a route with its GPS coordinates.
model BusStop {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId   String   @db.Uuid
  route     BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  nameAr    String
  nameEn    String?
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  stopOrder Int
  eta       String?  // Estimated arrival time "07:30"

  assignments BusRouteAssignment[]

  @@unique([routeId, stopOrder])
  @@map("bus_stops")
}

/// Assigns a student to a bus route and their boarding stop.
model BusRouteAssignment {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentProfileId String         @unique @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  routeId          String         @db.Uuid
  route            BusRoute       @relation(fields: [routeId], references: [id])
  stopId           String         @db.Uuid
  stop             BusStop        @relation(fields: [stopId], references: [id])
  isMorning        Boolean        @default(true)
  isAfternoon      Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@map("bus_route_assignments")
}

/// Immutable log of every NFC tap-in/out event on the bus.
/// MongoDB handles live telemetry; Postgres keeps the authoritative
/// per-trip record for attendance and billing audit.
model BoardingLog {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId     String         @db.Uuid
  route       BusRoute       @relation(fields: [routeId], references: [id])
  studentId   String         @db.Uuid
  student     User           @relation("BoardingStudent", fields: [studentId], references: [id])
  scannedById String         @db.Uuid
  scannedBy   User           @relation("ScannedByMatron", fields: [scannedById], references: [id])
  status      BoardingStatus
  scannedAt   DateTime       @default(now())
  latitude    Decimal?       @db.Decimal(10, 7)
  longitude   Decimal?       @db.Decimal(10, 7)

  @@index([routeId, scannedAt])
  @@index([studentId, scannedAt])
  @@map("boarding_logs")
}

// ──────────────────────────────────────────────────────────
//  AUTOMATED SUBSTITUTION ENGINE  (Al-Ihtiyat)
// ──────────────────────────────────────────────────────────

/// Recurring weekly time blocks where a teacher is available
/// to accept ad-hoc substitutions (free periods).
model TeacherAvailability {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherProfileId String         @db.Uuid
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  dayOfWeek        Int            // 0-4 (Sun-Thu)
  periodNumber     Int
  isAvailable      Boolean        @default(true)

  @@unique([teacherProfileId, dayOfWeek, periodNumber])
  @@map("teacher_availabilities")
}

/// Records a substitution event when a teacher is absent.
/// The algorithm layer (NestJS service) writes here after
/// resolving the best available substitute.
model TeacherSubstitution {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timetableSlotId     String             @db.Uuid
  timetableSlot       TimetableSlot      @relation(fields: [timetableSlotId], references: [id])
  absentTeacherId     String             @db.Uuid
  absentTeacher       User               @relation("AbsentTeacher", fields: [absentTeacherId], references: [id])
  substituteTeacherId String?            @db.Uuid
  substituteTeacher   User?              @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])
  date                DateTime           @db.Date
  status              SubstitutionStatus @default(PENDING)
  /// The lesson plan content shared with substitute
  lessonPlanUrl       String?
  notifiedAt          DateTime?
  confirmedAt         DateTime?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([timetableSlotId, date])
  @@index([date, substituteTeacherId])
  @@map("teacher_substitutions")
}

// ──────────────────────────────────────────────────────────
//  PARENT-TEACHER CONFERENCE (PTM) BOOKING
// ──────────────────────────────────────────────────────────

/// A PTM cycle groups all booking slots for a specific term.
model PTMCycle {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termId    String       @db.Uuid
  term      AcademicTerm @relation(fields: [termId], references: [id])
  title     String
  date      DateTime     @db.Date
  mode      PTMMode      @default(PHYSICAL)
  venueInfo String?      // Room or online link
  isOpen    Boolean      @default(false) // Parents can book only when open
  createdAt DateTime     @default(now())

  slots PTMSlot[]

  @@map("ptm_cycles")
}

/// A 10-minute slot available for a single teacher in a PTM cycle.
model PTMSlot {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleId    String    @db.Uuid
  cycle      PTMCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  teacherId  String    @db.Uuid
  teacher    User      @relation("TeacherPTMSlots", fields: [teacherId], references: [id])
  startTime  DateTime
  endTime    DateTime
  status     PTMStatus @default(AVAILABLE)
  /// Meet link / room for online mode
  meetingUrl String?

  booking PTMBooking?

  @@index([cycleId, teacherId])
  @@map("ptm_slots")
}

/// A parent's booking of a specific PTM slot.
model PTMBooking {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slotId      String    @unique @db.Uuid
  slot        PTMSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  parentId    String    @db.Uuid
  parent      User      @relation("ParentPTMBookings", fields: [parentId], references: [id])
  studentId   String    @db.Uuid // The student being discussed
  status      PTMStatus @default(BOOKED)
  checkedInAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  @@map("ptm_bookings")
}

// ──────────────────────────────────────────────────────────
//  SCHOOL STORE  (Uniforms, Books, Supplies)
// ──────────────────────────────────────────────────────────

model StoreItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nameAr      String
  nameEn      String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  imageUrl    String?
  /// "UNIFORM" | "BOOK" | "SUPPLY" | "ACTIVITY"
  category    String
  stockCount  Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  orderLines StoreOrderLine[]

  @@index([tenantId, category])
  @@map("store_items")
}

model StoreOrder {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String           @db.Uuid
  userId         String           @db.Uuid
  user           User             @relation(fields: [userId], references: [id])
  status         StoreOrderStatus @default(PENDING_PAYMENT)
  totalAmount    Decimal          @db.Decimal(12, 2)
  paymentMethod  PaymentMethod?
  paymentStatus  PaymentStatus    @default(PENDING)
  gatewayRef     String?
  /// Time-slotted pickup reservation
  pickupSlot     DateTime?
  pickupLocation String?
  pickedUpAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  lines StoreOrderLine[]

  @@index([tenantId, userId])
  @@map("store_orders")
}

model StoreOrderLine {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String     @db.Uuid
  order     StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String     @db.Uuid
  item      StoreItem  @relation(fields: [itemId], references: [id])
  quantity  Int
  unitPrice Decimal    @db.Decimal(10, 2)
  /// Captured size/variant at time of order (e.g., shirt size "L")
  variant   String?

  @@map("store_order_lines")
}

// ──────────────────────────────────────────────────────────
//  COMMUNICATION — TICKETS & MESSAGING
// ──────────────────────────────────────────────────────────

/// Categorized support queue (replaces WhatsApp for school comms).
model TicketQueue {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @db.Uuid
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "TRANSPORT" | "ACADEMIC" | "TUITION" | "CLINIC" | "GENERAL"
  category String
  nameAr   String
  nameEn   String

  tickets Ticket[]

  @@map("ticket_queues")
}

model Ticket {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queueId      String      @db.Uuid
  queue        TicketQueue @relation(fields: [queueId], references: [id])
  raisedById   String      @db.Uuid
  raisedBy     User        @relation("TicketRaiser", fields: [raisedById], references: [id])
  assignedToId String?     @db.Uuid
  assignedTo   User?       @relation("TicketAssignee", fields: [assignedToId], references: [id])
  title        String
  body         String
  /// "OPEN" | "IN_PROGRESS" | "RESOLVED" | "CLOSED"
  status       String      @default("OPEN")
  priority     String      @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  resolvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  messages Message[]

  @@index([queueId, status])
  @@map("tickets")
}

model Message {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId      String   @db.Uuid
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId      String   @db.Uuid
  sender        User     @relation("MessageSender", fields: [senderId], references: [id])
  body          String
  attachmentUrl String?
  seenAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("messages")
}

// ──────────────────────────────────────────────────────────
//  ANNOUNCEMENTS
// ──────────────────────────────────────────────────────────

model Announcement {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String       @db.Uuid
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorId      String       @db.Uuid
  author        User         @relation(fields: [authorId], references: [id])
  titleAr       String
  titleEn       String?
  bodyAr        String
  bodyEn        String?
  /// Target audience filter — empty array = broadcast to all
  targetRoles   SystemRole[]
  attachmentUrl String?
  publishedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([tenantId, publishedAt])
  @@map("announcements")
}
