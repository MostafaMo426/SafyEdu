# ──────────────────────────────────────────────────────────
#  SafyEdu Backend — Environment Variables
#  Copy this file to .env.local and fill in your values.
#  NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001

# PostgreSQL — matches docker-compose.yml defaults
DATABASE_URL="postgresql://safyedu:safyedu_secret@localhost:5433/safyedu_dev?schema=public"

# MongoDB (High-velocity telemetry)
# Local Docker: mongodb://safyedu:safyedu_secret@localhost:27017/safyedu_telemetry?authSource=admin
# Atlas:        mongodb+srv://USER:PASS@cluster.mongodb.net/safyedu_telemetry
MONGODB_URI="mongodb://safyedu:safyedu_secret@localhost:27017/safyedu_telemetry?authSource=admin&replicaSet=rs0"
MONGO_USER=safyedu
MONGO_PASSWORD=safyedu_secret

# JWT — Generate strong secrets: openssl rand -base64 64
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL=900

# Cloudflare R2 / AWS S3 (Phase 5)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=safyedu-media

# Paymob (Phase 3)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=

# Fawry (Phase 3)
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

# Firebase (Push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
