# ─────────────────────────────────────────────────────────────
#  SafyEdu — Docker Compose Environment Variables
#  Copy to .env in the repo root (alongside docker-compose.yml)
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=safyedu
POSTGRES_PASSWORD=safyedu_secret
POSTGRES_DB=safyedu_dev
POSTGRES_PORT=5432

# MongoDB
MONGO_USER=safyedu
MONGO_PASSWORD=safyedu_secret
MONGO_DB=safyedu_telemetry
MONGO_PORT=27017

# Redis
REDIS_PASSWORD=safyedu_redis_secret
REDIS_PORT=6379

# pgAdmin
PGADMIN_EMAIL=admin@safyedu.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
